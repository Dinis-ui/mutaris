# Copiar para .env.local — ou, mais simples, correr:
#   node apps/web/scripts/setup-admin.mjs
# (cria/atualiza estas duas variáveis automaticamente)

# Segredo para assinar as sessões do backoffice (mínimo 32 caracteres).
BACKOFFICE_SESSION_SECRET=

# Contas de administrador (JSON). A password é guardada como hash scrypt.
BACKOFFICE_ADMINS='[{"email":"admin@exemplo.pt","name":"Nome","passwordHash":"scrypt:<salt>:<hash>"}]'

# Ligação à base de dados PostgreSQL (ex.: a connection string do Neon).
DATABASE_URL=
